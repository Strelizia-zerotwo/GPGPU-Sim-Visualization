{
  "name": "gpgpu-studio",
  "version": "0.6.1",
  "private": true,
  "description": "GPGPU-Sim desktop experiment manager for WSL and Linux",
  "main": "desktop/main.cjs",
  "author": "GPGPU Studio contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs && python -m unittest discover -s tests -p test_*.py",
    "test:desktop": "node tests/canvas-smoke.cjs",
    "test:enhancements": "node tests/enhancements-smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win portable --x64",
    "test:modules": "node tests/canvas-smoke.cjs",
    "test:canvas": "node tests/canvas-smoke.cjs",
    "test:profiler": "node tests/profiler-smoke.cjs",
    "test:workspace": "node tests/workspace-smoke.cjs",
    "test:studio": "node tests/studio-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "org.gpgpustudio.desktop",
    "productName": "GPGPU Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "*.py",
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "portable": {
      "artifactName": "GPGPU-Studio-${version}-Windows-${arch}.exe"
    }
  }
}
